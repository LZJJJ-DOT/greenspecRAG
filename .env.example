# Docker Compose accepts forward slashes on Windows. Keep all mutable runtime data on D:.
RAG_RUNTIME_ROOT=D:/greenspec-rag-runtime

# The Qdrant ports are intentionally bound to 127.0.0.1 only.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Pin a ref when governance requires a particular model revision. The downloader
# records the resolved commit SHA in model_manifest.json in every case.
MODEL_BGE_REVISION=main
MODEL_RERANKER_REVISION=main

# Used only by the one-shot `ragas-eval` service. Never commit the real key.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
RAGAS_ANSWER_PROVIDER=deepseek
RAGAS_ANSWER_BASE_URL=https://api.deepseek.com
RAGAS_ANSWER_API_KEY_ENV=DEEPSEEK_API_KEY
RAGAS_JUDGE_PROVIDER=deepseek
RAGAS_JUDGE_BASE_URL=https://api.deepseek.com
RAGAS_JUDGE_MODEL=deepseek-v4-flash
RAGAS_JUDGE_API_KEY_ENV=DEEPSEEK_API_KEY
