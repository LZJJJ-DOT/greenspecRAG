{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://greenspec.local/schemas/evaluation_question.schema.json",
  "title":"GreenSpec retrieval evaluation question",
  "type":"object","additionalProperties":false,
