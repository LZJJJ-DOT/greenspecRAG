  "properties":{
    "eval_id":{"type":"string","pattern":"^E[0-9]{3,}$"},"question":{"type":"string","minLength":1},"request":{"type":"object","additionalProperties":false,"required":["query","project_profile","filters","top_k","allow_degraded"],"properties":{"query":{"type":"string","minLength":1,"maxLength":4000},"project_profile":{"type":"object"},"filters":{"type":"object","additionalProperties":false,"required":["standard_ids","clause_nos","as_of_date","must_be_current","include_commentary"],"properties":{"standard_ids":{"type":"array","items":{"type":"string"}},"clause_nos":{"type":"array","items":{"type":"string"}},"as_of_date":{"type":["string","null"],"format":"date"},"must_be_current":{"type":"boolean"},"include_commentary":{"type":"boolean"}}},"top_k":{"type":"integer","minimum":1,"maximum":100},"allow_degraded":{"type":"boolean"}}},"expected_content_type":{"type":"string"},"expected_answer_type":{"enum":["clause_lookup","threshold_lookup","formula_lookup","filtered_retrieval","commentary_exclusion","table_continuation","version_boundary","no_evidence","missing_facts","pending_relation","degraded_retrieval","citation_completeness"]},"expected_standard_ids":{"type":"array","items":{"type":"string"}},"expected_clause_nos":{"type":"array","items":{"type":"string"}},"required_evidence":{"type":"array","items":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string"},"value":{"type":["string","null"]}},"additionalProperties":false}},"gold_evidence_ids":{"type":"array","items":{"type":"string"}},"known_missing_facts":{"type":"array","items":{"type":"string"}},"expected_degraded_modes":{"type":"array","items":{"type":"string"}},"manual_review_reason":{"type":["string","null"]},
    "human_annotation":{"type":"object","additionalProperties":false,"required":["relevance","citation_accuracy","citation_completeness","answer_supported","needs_manual_review","missing_facts_captured","annotator","annotated_at","notes"],"properties":{"relevance":{"type":["integer","null"],"minimum":0,"maximum":2},"citation_accuracy":{"type":["boolean","null"]},"citation_completeness":{"type":["boolean","null"]},"answer_supported":{"type":["boolean","null"]},"needs_manual_review":{"type":["boolean","null"]},"missing_facts_captured":{"type":["boolean","null"]},"annotator":{"type":["string","null"]},"annotated_at":{"type":["string","null"],"format":"date-time"},"notes":{"type":["string","null"]}}}
  }
